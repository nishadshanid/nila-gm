# Supabase (the Nila Gym project) → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" (legacy) or "publishable" key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" (legacy) or "secret" key. Server-only, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# A long random string (e.g. `openssl rand -hex 32`). Supabase sends it to /api/cron/tick.
CRON_SECRET=

# Phone notifications. Generate once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services, e.g. mailto:you@gmail.com
VAPID_SUBJECT=
